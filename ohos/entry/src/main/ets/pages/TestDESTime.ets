import CryptoJS from "@ohos/crypto-js"

@Entry
@Component
struct Index {
  @State message: string = 'Hello World'

  build() {
    Row() {
      Column() {
        Text(this.message)
          .fontSize(50)
          .fontWeight(FontWeight.Bold)
          .onClick(() => {
            let key: string = '12345678abcdabcd'
            let word: string = ""
              + ""
              + ""
              + ""
            let time: number = new Date().getTime()
            let value: string = this.tripleDESEncrypt(word, key)
            console.log("time == 加密耗时： " + (new Date().getTime() - time))

            let time1: number = new Date().getTime()
            let value2: string = this.tripleDESDncrypt(value, key)
            console.log("time == 解密密耗时： " + (new Date().getTime() - time1))
          })
      }
      .width('100%')
    }
    .height('100%')
  }

  tripleDESEncrypt(word: string, key: string) {
    let hexkey = CryptoJS.enc.Hex.parse(key)
    let encryptTripl = CryptoJS.TripleDES.encrypt(word, hexkey, {
      mode: CryptoJS.mode.ECB,
      padding: CryptoJS.pad.Pkcs7
    }).ciphertext.toString(CryptoJS.enc.Base64)
    return encryptTripl
  }

  tripleDESDncrypt(word: string, key: string) {
    let hexkey = CryptoJS.enc.Hex.parse(key)
    let decryptTripl = CryptoJS.TripleDES.decrypt(word, hexkey, {
      mode: CryptoJS.mode.ECB,
      padding: CryptoJS.pad.Pkcs7
    }).toString(CryptoJS.enc.Utf8)
    return decryptTripl
  }
}